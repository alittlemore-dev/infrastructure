# Application images. The registry/repository prefix must not end with a slash.
IMAGE_REGISTRY=registry.example.com/alittlemore-dev

# Public edge and TLS.
PERSONAL_WORKSPACE_DOMAIN=personal-workspace.alittlemore.dev
COMPETENCY_DOMAIN=competency.alittlemore.dev
MINIO_DOMAIN=s3.alittlemore.dev
APP_URL_SCHEMA=https
LE_EMAIL=your.letsencrypt@email.com
TLS_CERTIFICATE_NAME=alittlemore-apps
SSL_CERT=/certs/current/fullchain.pem
SSL_KEY=/certs/current/privkey.pem
VPN_BIND_ADDRESS=127.0.0.1

# Shared object storage. Use distinct access-key identities and secret keys.
MINIO_ROOT_ACCESS_KEY=alittlemore-infra-admin
MINIO_ROOT_SECRET_KEY=replace-me
MINIO_REGION=us-east-1
MINIO_CORS_MAX_AGE_SECONDS=300
DATABASUS_MINIO_ACCESS_KEY=databasus
DATABASUS_MINIO_SECRET_KEY=replace-me

# Personal Workspace application.
PERSONAL_WORKSPACE_APP_DEBUG=false
PERSONAL_WORKSPACE_APP_SECRET_KEY=replace-me
PERSONAL_WORKSPACE_APP_USE_CACHE=true
PERSONAL_WORKSPACE_AUTH_SESSION_TTL_SECONDS=86400
PERSONAL_WORKSPACE_FILES_ORPHAN_RETENTION_SECONDS=604800
PERSONAL_WORKSPACE_I18N_DEFAULT_LANGUAGE=ru
PERSONAL_WORKSPACE_OWNER_USERNAME=owner
PERSONAL_WORKSPACE_OWNER_PASSWORD_HASH=replace-with-generated-hash
PERSONAL_WORKSPACE_SENTRY_USE=false
PERSONAL_WORKSPACE_SENTRY_DSN=
PERSONAL_WORKSPACE_TASKIQ_CACHE_WARM_INTERVAL_SECONDS=3600
PERSONAL_WORKSPACE_TASKIQ_FILE_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
PERSONAL_WORKSPACE_TASKIQ_RESULT_EXPIRE_SECONDS=3600

# Personal Workspace database.
PERSONAL_WORKSPACE_DB_USER=personal_workspace
PERSONAL_WORKSPACE_DB_PASSWORD=replace-me
PERSONAL_WORKSPACE_DB_DRIVER=postgresql+psycopg
PERSONAL_WORKSPACE_DB_NAME=personal_workspace_database
PERSONAL_WORKSPACE_DB_POOL_PRE_PING=true
PERSONAL_WORKSPACE_DB_POOL_SIZE=10
PERSONAL_WORKSPACE_DB_MAX_OVERFLOW=20
PERSONAL_WORKSPACE_DB_EXPIRE_ON_COMMIT=false
PERSONAL_WORKSPACE_DB_LOG_QUERY_METRICS=false
PERSONAL_WORKSPACE_DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
PERSONAL_WORKSPACE_DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000

# Personal Workspace object storage.
PERSONAL_WORKSPACE_MINIO_ACCESS_KEY=personal-workspace
PERSONAL_WORKSPACE_MINIO_SECRET_KEY=replace-me

# Competency Trainer application.
COMPETENCY_APP_CONTACT_REQUESTS_ENABLED=false
COMPETENCY_APP_DEBUG=false
COMPETENCY_APP_SECRET_KEY=replace-me
COMPETENCY_APP_USE_CACHE=true
COMPETENCY_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n(base64 content)\n-----END PUBLIC KEY-----"
COMPETENCY_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n(base64 content)\n-----END PRIVATE KEY-----"
COMPETENCY_AUTH_TOKEN_EXPIRE_SECONDS=900
COMPETENCY_AUTH_SESSION_EXPIRE_SECONDS=2592000
COMPETENCY_AUTH_SESSION_ABSOLUTE_EXPIRE_SECONDS=2592000
COMPETENCY_AUTH_TOKEN_HEADER_NAME=Authorization
COMPETENCY_AUTH_TOKEN_PREFIX=Bearer
COMPETENCY_CACHE_WARM_ARTICLES_PAGE_SIZE=10
COMPETENCY_MATRIX_QUESTION_SUGGESTION_ANONYMOUS_DAILY_LIMIT=10
COMPETENCY_FILES_ORPHAN_RETENTION_SECONDS=604800
COMPETENCY_I18N_DEFAULT_LANGUAGE=ru
COMPETENCY_OWNER_INIT_LOGIN=owner
COMPETENCY_OWNER_INIT_PASSWORD=replace-me
COMPETENCY_SENTRY_USE=false
COMPETENCY_SENTRY_DSN=
COMPETENCY_TASKIQ_AUTH_SESSION_PRUNE_INTERVAL_SECONDS=86400
COMPETENCY_TASKIQ_AGENT_AUDIT_PRUNE_INTERVAL_SECONDS=86400
COMPETENCY_TASKIQ_CACHE_WARM_INTERVAL_SECONDS=3600
COMPETENCY_TASKIQ_FILE_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
COMPETENCY_TASKIQ_RESULT_EXPIRE_SECONDS=3600

# Competency Trainer database.
COMPETENCY_DB_USER=competency_trainer
COMPETENCY_DB_PASSWORD=replace-me
COMPETENCY_DB_DRIVER=postgresql+psycopg
COMPETENCY_DB_NAME=competency_trainer_database
COMPETENCY_DB_POOL_PRE_PING=true
COMPETENCY_DB_POOL_SIZE=10
COMPETENCY_DB_MAX_OVERFLOW=20
COMPETENCY_DB_EXPIRE_ON_COMMIT=false
COMPETENCY_DB_LOG_QUERY_METRICS=false
COMPETENCY_DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
COMPETENCY_DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000

# Competency Trainer object storage.
COMPETENCY_MINIO_ACCESS_KEY=competency-trainer
COMPETENCY_MINIO_SECRET_KEY=replace-me

# Competency Trainer agent PKI. Keep the literal \n escapes in .env.
COMPETENCY_AGENT_ACCESS_ISSUING_CERTIFICATE="-----BEGIN CERTIFICATE-----\n(agent issuing certificate)\n-----END CERTIFICATE-----"
COMPETENCY_AGENT_ACCESS_ISSUING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n(agent issuing private key)\n-----END PRIVATE KEY-----"
COMPETENCY_AGENT_ACCESS_CERTIFICATE_CHAIN="-----BEGIN CERTIFICATE-----\n(agent issuing certificate)\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n(agent root certificate)\n-----END CERTIFICATE-----"
