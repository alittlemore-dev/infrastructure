map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_status 429;
limit_req_zone $binary_remote_addr zone=auth_api_per_ip:20m rate=120r/m;
limit_req_zone $binary_remote_addr zone=auth_login_per_ip:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=auth_refresh_per_ip:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=personal_api_per_ip:20m rate=120r/m;
limit_req_zone $binary_remote_addr zone=competency_api_per_ip:20m rate=120r/m;
limit_req_zone $binary_remote_addr zone=competency_contact_per_ip:10m rate=3r/m;
limit_req_zone $binary_remote_addr zone=competency_matrix_suggestion_per_ip:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=competency_heavy_read_per_ip:10m rate=30r/m;
limit_req_zone $ssl_client_fingerprint zone=competency_agent_api_per_certificate:10m rate=30r/m;

resolver 127.0.0.11 valid=10s ipv6=off;

upstream personal_workspace_backend {
    zone personal_workspace_backend_zone 64k;
    server ${PERSONAL_WORKSPACE_ACTIVE_BACKEND}:8080 resolve;
}

upstream competency_backend {
    zone competency_backend_zone 64k;
    server ${COMPETENCY_ACTIVE_BACKEND}:8080 resolve;
}

upstream auth_api_backend {
    zone auth_api_backend_zone 64k;
    server ${AUTH_API_ACTIVE_BACKEND}:8080 resolve;
}

upstream frontend {
    zone frontend_zone 64k;
    server ${FRONTEND_ACTIVE}:4000 resolve;
}

upstream minio_api {
    zone minio_api_zone 64k;
    server minio:9000 resolve;
}
upstream minio_panel {
    zone minio_panel_zone 64k;
    server minio:9001 resolve;
}
upstream databasus {
    zone databasus_zone 64k;
    server databasus:4005 resolve;
}

server {
    listen 8080 default_server;
    server_name _;

    location = /nginx-healthz {
        access_log off;
        default_type text/plain;
        return 200 "";
    }

    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name
        ${APP_DOMAIN}
        ${MINIO_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8080;
    server_name agent.${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 404;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        return 404;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: ${MINIO_PUBLIC_URL}; font-src 'self' data:; style-src 'self' 'nonce-$request_id'; script-src 'self' 'nonce-$request_id'; script-src-attr 'none'; connect-src 'self' ${MINIO_PUBLIC_URL}; upgrade-insecure-requests" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-CSP-Nonce $request_id;
    proxy_set_header X-Agent-Client-Certificate "";
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "";
    }

    location ^~ /internal/agent/v1 {
        return 404;
    }

    location ^~ /api/personal-workspace/docs {
        limit_req zone=personal_api_per_ip burst=120 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: ${MINIO_PUBLIC_URL} https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' ${MINIO_PUBLIC_URL}; upgrade-insecure-requests" always;
        proxy_redirect ~^https?://[^/]+/api/(.*)$ $scheme://$host/api/personal-workspace/$1;
        proxy_redirect ~^/api/(.*)$ /api/personal-workspace/$1;
        proxy_pass http://personal_workspace_backend/api/docs;
    }

    location ^~ /api/personal-workspace/ {
        limit_req zone=personal_api_per_ip burst=120 nodelay;
        proxy_redirect ~^https?://[^/]+/api/(.*)$ $scheme://$host/api/personal-workspace/$1;
        proxy_redirect ~^/api/(.*)$ /api/personal-workspace/$1;
        proxy_pass http://personal_workspace_backend/api/;
    }

    location = /api/auth/login/ {
        absolute_redirect off;
        return 308 /api/auth/login$is_args$args;
    }

    location = /api/auth/login {
        limit_req zone=auth_login_per_ip burst=5 nodelay;
        proxy_pass http://auth_api_backend;
    }

    location = /api/auth/refresh/ {
        absolute_redirect off;
        return 308 /api/auth/refresh$is_args$args;
    }

    location = /api/auth/refresh {
        limit_req zone=auth_refresh_per_ip burst=30 nodelay;
        proxy_pass http://auth_api_backend;
    }

    location ^~ /api/auth/docs {
        limit_req zone=auth_api_per_ip burst=120 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: ${MINIO_PUBLIC_URL} https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' ${MINIO_PUBLIC_URL}; upgrade-insecure-requests" always;
        proxy_pass http://auth_api_backend/api/auth/docs;
    }

    location ^~ /api/auth/ {
        limit_req zone=auth_api_per_ip burst=120 nodelay;
        proxy_pass http://auth_api_backend;
    }

    location = /api/competency/contacts {
        limit_req zone=competency_contact_per_ip burst=3 nodelay;
        proxy_pass http://competency_backend/api/contacts;
    }

    location = /api/competency/competency-matrix/question-suggestions {
        limit_req zone=competency_matrix_suggestion_per_ip burst=5 nodelay;
        proxy_pass http://competency_backend/api/competency-matrix/question-suggestions;
    }

    location ^~ /api/competency/docs {
        limit_req zone=competency_api_per_ip burst=120 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: ${MINIO_PUBLIC_URL} https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' ${MINIO_PUBLIC_URL}; upgrade-insecure-requests" always;
        proxy_redirect ~^https?://[^/]+/api/(.*)$ $scheme://$host/api/competency/$1;
        proxy_redirect ~^/api/(.*)$ /api/competency/$1;
        proxy_pass http://competency_backend/api/docs;
    }

    location = /api/competency/articles {
        limit_req zone=competency_heavy_read_per_ip burst=30 nodelay;
        proxy_pass http://competency_backend/api/articles;
    }

    location = /api/competency/admin/articles/tags/search {
        limit_req zone=competency_heavy_read_per_ip burst=30 nodelay;
        proxy_pass http://competency_backend/api/admin/articles/tags/search;
    }

    location = /api/competency/admin/competency-matrix/resources/search {
        limit_req zone=competency_heavy_read_per_ip burst=30 nodelay;
        proxy_pass http://competency_backend/api/admin/competency-matrix/resources/search;
    }

    location ^~ /api/competency/ {
        limit_req zone=competency_api_per_ip burst=120 nodelay;
        proxy_redirect ~^https?://[^/]+/api/(.*)$ $scheme://$host/api/competency/$1;
        proxy_redirect ~^/api/(.*)$ /api/competency/$1;
        proxy_pass http://competency_backend/api/;
    }

    location /api/ {
        return 404;
    }

    location = /sitemap.xml {
        proxy_pass http://competency_backend/sitemap.xml;
    }

    location = /robots.txt {
        proxy_pass http://competency_backend/robots.txt;
    }

    location / {
        proxy_pass http://frontend;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${MINIO_DOMAIN};

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location = /knowledge-private {
        return 404;
    }

    location ^~ /knowledge-private/ {
        return 404;
    }

    location = /database-backups {
        return 404;
    }

    location ^~ /database-backups/ {
        return 404;
    }

    location / {
        proxy_pass http://minio_api;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name agent.${APP_DOMAIN};

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        return 404;
    }
}

