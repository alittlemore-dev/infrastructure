server {
    listen 18083 ssl;
    server_name agent.${APP_DOMAIN};

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_client_certificate /run/secrets/agent_client_ca_certificate;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /dev/stdout agent_api_json;
    client_max_body_size 256k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Agent-Client-Certificate $ssl_client_escaped_cert;
    proxy_buffering off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location = /internal/agent/v1/matrix/question-claims {
        if ($request_method != POST) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=10 nodelay;
        proxy_pass http://competency_backend;
    }

    location = /internal/agent/v1/matrix/authoring-context {
        if ($request_method != GET) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=10 nodelay;
        proxy_pass http://competency_backend;
    }

    location = /internal/agent/v1/matrix/resources {
        if ($request_method != GET) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=10 nodelay;
        proxy_pass http://competency_backend;
    }

    location ~ "^/internal/agent/v1/matrix/question-claims/[0-9a-f]{32}/draft$" {
        if ($request_method != PUT) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=10 nodelay;
        proxy_pass http://competency_backend;
    }

    location ~ "^/internal/agent/v1/matrix/question-claims/[0-9a-f]{32}$" {
        if ($request_method != DELETE) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=10 nodelay;
        proxy_pass http://competency_backend;
    }

    location = /internal/agent/v1/certificate-rotations {
        if ($request_method != POST) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=3 nodelay;
        proxy_pass http://competency_backend;
    }

    location ~ "^/internal/agent/v1/certificate-rotations/[0-9a-f]{32}/confirm$" {
        if ($request_method != POST) { return 405; }
        limit_req zone=competency_agent_api_per_certificate burst=3 nodelay;
        proxy_pass http://competency_backend;
    }

    location / {
        return 404;
    }
}
