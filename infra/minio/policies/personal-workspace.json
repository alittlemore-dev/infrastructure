{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::media",
        "arn:aws:s3:::media/*",
        "arn:aws:s3:::knowledge-private",
        "arn:aws:s3:::knowledge-private/*",
        "arn:aws:s3:::resume-private",
        "arn:aws:s3:::resume-private/*"
      ]
    }
  ]
}
