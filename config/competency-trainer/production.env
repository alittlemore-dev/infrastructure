# Application.
APP_CONTACT_REQUESTS_ENABLED=false
APP_DEBUG=false
APP_DOMAIN=alittlemore.dev
APP_USE_CACHE=true
FILES_ORPHAN_RETENTION_SECONDS=604800
I18N_DEFAULT_LANGUAGE=en
OWNER_INIT_LOGIN=ALittleMoron
SENTRY_USE=false

# Authentication.
AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAh9WUmX8PGaQ4XSOXwJ6yuTzxsWc0nnGCyMaUdPBXah4=\n-----END PUBLIC KEY-----"
AUTH_SESSION_ABSOLUTE_EXPIRE_SECONDS=31556952
AUTH_SESSION_EXPIRE_SECONDS=2592000
AUTH_TOKEN_EXPIRE_SECONDS=900
AUTH_TOKEN_HEADER_NAME=Authorization
AUTH_TOKEN_PREFIX=Bearer

# Competency Matrix.
CACHE_WARM_ARTICLES_PAGE_SIZE=10
COMPETENCY_MATRIX_QUESTION_SUGGESTION_ANONYMOUS_DAILY_LIMIT=3

# TaskIQ.
TASKIQ_AGENT_AUDIT_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_AUTH_SESSION_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_CACHE_WARM_INTERVAL_SECONDS=3600
TASKIQ_FILE_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_RESULT_EXPIRE_SECONDS=3600

# Database.
DB_USER=my_site
DB_DRIVER=postgresql+psycopg
DB_NAME=my_site_database
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_EXPIRE_ON_COMMIT=true
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000
