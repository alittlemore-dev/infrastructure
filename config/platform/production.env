# Container image registry.
IMAGE_REGISTRY=ghcr.io/alittlemore-dev

# Shared public edge and TLS.
APP_URL_SCHEMA=https
APP_DOMAIN=alittlemore.dev
LE_EMAIL=d.lunev.dev@gmail.com
TLS_CERTIFICATE_NAME=alittlemore-apps
SSL_CERT=/certs/current/fullchain.pem
SSL_KEY=/certs/current/privkey.pem
VPN_BIND_ADDRESS=10.77.0.1

# Shared object storage.
MINIO_DOMAIN=s3.alittlemore.dev
MINIO_REGION=us-east-1
MINIO_CORS_MAX_AGE_SECONDS=300

# The production host keeps the private age identity outside deploy releases.
SOPS_AGE_KEY_FILE=/etc/alittlemore-infra/sops-age-key.txt
