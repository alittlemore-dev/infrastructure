# Local Compose interpolation. Secrets and checkout paths come from .dev-state/compose.env.
IMAGE_REGISTRY=alittlemore-dev
APP_URL_SCHEMA=https
APP_DOMAIN=alittlemore.localhost
TLS_CERTIFICATE_NAME=local-development
SSL_CERT=/certs/fullchain.pem
SSL_KEY=/certs/privkey.pem
VPN_BIND_ADDRESS=127.0.0.1

MINIO_DOMAIN=s3.localhost
MINIO_REGION=us-east-1
MINIO_CORS_MAX_AGE_SECONDS=300

PERSONAL_WORKSPACE_DB_USER=personal_workspace
PERSONAL_WORKSPACE_DB_NAME=personal_workspace
PERSONAL_WORKSPACE_ENV_FILE=./config/personal-workspace/development.env

COMPETENCY_DB_USER=competency_trainer
COMPETENCY_DB_NAME=competency_trainer
COMPETENCY_ENV_FILE=./config/competency-trainer/development.env

NGINX_IMAGE=alittlemore-dev/nginx:local
