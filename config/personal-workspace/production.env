# Application.
APP_DEBUG=false
APP_DOMAIN=alittlemore.dev
APP_USE_CACHE=true
FILES_ORPHAN_RETENTION_SECONDS=604800
I18N_DEFAULT_LANGUAGE=en
SENTRY_USE=true

# Auth API.
AUTH_TIMEOUT_SECONDS=2
AUTH_CACHE_TTL_SECONDS=15
AUTH_MAX_CACHE_ENTRIES=10000

# TaskIQ.
TASKIQ_CACHE_WARM_INTERVAL_SECONDS=3600
TASKIQ_FILE_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_RESULT_EXPIRE_SECONDS=3600

# Database.
DB_USER=my_site
DB_DRIVER=postgresql+psycopg
DB_NAME=my_site_database
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_EXPIRE_ON_COMMIT=true
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000
