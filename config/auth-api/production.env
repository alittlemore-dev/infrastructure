APP_DEBUG=false
APP_DOMAIN=alittlemore.dev
SENTRY_USE=true
AUTH_SESSION_ABSOLUTE_EXPIRE_SECONDS=31556952
AUTH_SESSION_EXPIRE_SECONDS=2592000
AUTH_TOKEN_EXPIRE_SECONDS=900
AUTH_TOKEN_HEADER_NAME=Authorization
AUTH_TOKEN_PREFIX=Bearer
TASKIQ_AUTH_SESSION_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_ACCOUNT_AVATAR_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_RESULT_EXPIRE_SECONDS=3600
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_BUCKET=auth-avatars
MINIO_SECURE=false
MINIO_ADDRESSING_STYLE=path
DB_USER=auth_api
DB_DRIVER=postgresql+psycopg
DB_NAME=auth_api
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_EXPIRE_ON_COMMIT=true
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000
